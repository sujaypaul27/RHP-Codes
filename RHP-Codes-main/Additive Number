class Solution {

    public boolean isAdditiveNumber(String num) {

        int n = num.length();

        // Choose the first number
        for (int i = 1; i <= n / 2; i++) {

            // Leading zero is not allowed
            if (num.charAt(0) == '0' && i > 1) {
                break;
            }

            String first = num.substring(0, i);

            // Choose the second number
            for (int j = i + 1; j < n; j++) {

                int secondLength = j - i;

                // Remaining characters must be able
                // to contain at least one more number
                if (n - j < Math.max(i, secondLength)) {
                    continue;
                }

                if (num.charAt(i) == '0' && secondLength > 1) {
                    break;
                }

                String second = num.substring(i, j);

                if (check(num, j, first, second)) {
                    return true;
                }
            }
        }

        return false;
    }

    private boolean check(
            String num,
            int index,
            String first,
            String second) {

        int count = 2;

        while (index < num.length()) {

            String sum = add(first, second);

            // The next characters must equal the sum
            if (!num.startsWith(sum, index)) {
                return false;
            }

            index += sum.length();

            first = second;
            second = sum;

            count++;
        }

        return count >= 3;
    }

    // String addition without integer conversion
    private String add(String a, String b) {

        StringBuilder result = new StringBuilder();

        int i = a.length() - 1;
        int j = b.length() - 1;
        int carry = 0;

        while (i >= 0 || j >= 0 || carry > 0) {

            int sum = carry;

            if (i >= 0) {
                sum += a.charAt(i--) - '0';
            }

            if (j >= 0) {
                sum += b.charAt(j--) - '0';
            }

            result.append(sum % 10);
            carry = sum / 10;
        }

        return result.reverse().toString();
    }
}
