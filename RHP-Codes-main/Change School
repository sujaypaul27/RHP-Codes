import java.io.*;
import java.util.*;

public class Main {

    public static void main(String[] args) throws Exception {

        BufferedReader br =
                new BufferedReader(new InputStreamReader(System.in));

        StringTokenizer st =
                new StringTokenizer(br.readLine());

        int N = Integer.parseInt(st.nextToken());
        int K = Integer.parseInt(st.nextToken());

        int[] count = new int[K];

        st = new StringTokenizer(br.readLine());

        for (int i = 0; i < N; i++) {
            int classNo = Integer.parseInt(st.nextToken()) - 1;
            count[classNo]++;
        }

        // Find the current maximum class size
        int max = 0;

        for (int students : count) {
            max = Math.max(max, students);
        }

        // After Takahashi joins a class,
        // its size becomes count[i] + 1.
        int answer = 0;

        for (int students : count) {
            if (students + 1 >= max) {
                answer++;
            }
        }

        System.out.println(answer);
    }
}
