import java.io.*;
import java.util.*;

public class Main {

    static class Person {
        long height;
        long leave;

        Person(long height, long leave) {
            this.height = height;
            this.leave = leave;
        }
    }

    public static void main(String[] args) throws Exception {

        BufferedReader br =
                new BufferedReader(new InputStreamReader(System.in));

        int N = Integer.parseInt(br.readLine());

        Deque<Person> stack = new ArrayDeque<>();

        for (int i = 0; i < N; i++) {

            StringTokenizer st =
                    new StringTokenizer(br.readLine());

            long H = Long.parseLong(st.nextToken());
            long L = Long.parseLong(st.nextToken());

            // Remove people who can never be the tallest.
            while (!stack.isEmpty()
                    && stack.peekLast().height <= H) {

                stack.pollLast();
            }

            stack.addLast(new Person(H, L));
        }

        // Convert stack to arrays.
        int size = stack.size();

        long[] heights = new long[size];
        long[] leaves = new long[size];

        int index = 0;

        for (Person p : stack) {
            heights[index] = p.height;
            leaves[index] = p.leave;
            index++;
        }

        int Q = Integer.parseInt(br.readLine());

        StringTokenizer st =
                new StringTokenizer(br.readLine());

        StringBuilder out = new StringBuilder();

        while (Q-- > 0) {

            long T = Long.parseLong(st.nextToken());

            /*
             * Find the first person whose leaving time
             * is strictly greater than T.
             *
             * That person is the tallest person still
             * present at T + 1/2.
             */
            int pos = upperBound(leaves, T);

            out.append(heights[pos]).append('\n');
        }

        System.out.print(out);
    }

    // First index where arr[index] > target
    static int upperBound(long[] arr, long target) {

        int left = 0;
        int right = arr.length;

        while (left < right) {

            int mid = left + (right - left) / 2;

            if (arr[mid] <= target) {
                left = mid + 1;
            } else {
                right = mid;
            }
        }

        return left;
    }
}
