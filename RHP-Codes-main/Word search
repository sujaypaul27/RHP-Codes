class Solution {

    private int rows;
    private int cols;
    private char[][] board;
    private String word;

    private final int[] dr = {-1, 1, 0, 0};
    private final int[] dc = {0, 0, -1, 1};

    public boolean exist(char[][] board, String word) {

        this.board = board;
        this.word = word;

        rows = board.length;
        cols = board[0].length;

        for (int r = 0; r < rows; r++) {
            for (int c = 0; c < cols; c++) {

                if (board[r][c] == word.charAt(0)
                        && dfs(r, c, 0)) {
                    return true;
                }
            }
        }

        return false;
    }

    private boolean dfs(int r, int c, int index) {

        // All characters matched
        if (index == word.length()) {
            return true;
        }

        // Boundary check
        if (r < 0 || r >= rows ||
            c < 0 || c >= cols) {
            return false;
        }

        // Character mismatch
        if (board[r][c] != word.charAt(index)) {
            return false;
        }

        // Mark as visited
        char original = board[r][c];
        board[r][c] = '#';

        // Explore 4 directions
        for (int d = 0; d < 4; d++) {

            if (dfs(
                    r + dr[d],
                    c + dc[d],
                    index + 1)) {

                return true;
            }
        }

        // Backtrack
        board[r][c] = original;

        return false;
    }
}
