import java.util.*;

class Solution {

    private int n;
    private int[][] grid;
    private int[] size;
    
    private final int[] dr = {-1, 1, 0, 0};
    private final int[] dc = {0, 0, -1, 1};

    public int largestIsland(int[][] grid) {
        this.grid = grid;
        this.n = grid.length;

        // Maximum possible island id is n*n + 1
        size = new int[n * n + 2];

        int islandId = 2;
        int maxIsland = 0;

        // Step 1: Label every island and calculate its size
        for (int r = 0; r < n; r++) {
            for (int c = 0; c < n; c++) {

                if (grid[r][c] == 1) {
                    int islandSize = dfs(r, c, islandId);

                    size[islandId] = islandSize;
                    maxIsland = Math.max(maxIsland, islandSize);

                    islandId++;
                }
            }
        }

        // Step 2: Try changing every 0 to 1
        for (int r = 0; r < n; r++) {
            for (int c = 0; c < n; c++) {

                if (grid[r][c] != 0) {
                    continue;
                }

                int currentSize = 1;

                // At most 4 different neighboring islands
                int[] neighbors = new int[4];
                int count = 0;

                for (int d = 0; d < 4; d++) {
                    int nr = r + dr[d];
                    int nc = c + dc[d];

                    if (nr < 0 || nr >= n || nc < 0 || nc >= n) {
                        continue;
                    }

                    int id = grid[nr][nc];

                    if (id <= 1) {
                        continue;
                    }

                    // Avoid counting the same island twice
                    boolean alreadyAdded = false;

                    for (int i = 0; i < count; i++) {
                        if (neighbors[i] == id) {
                            alreadyAdded = true;
                            break;
                        }
                    }

                    if (!alreadyAdded) {
                        neighbors[count++] = id;
                        currentSize += size[id];
                    }
                }

                maxIsland = Math.max(maxIsland, currentSize);
            }
        }

        return maxIsland;
    }

    private int dfs(int r, int c, int islandId) {
        if (r < 0 || r >= n || c < 0 || c >= n || grid[r][c] != 1) {
            return 0;
        }

        grid[r][c] = islandId;

        int count = 1;

        for (int d = 0; d < 4; d++) {
            count += dfs(
                r + dr[d],
                c + dc[d],
                islandId
            );
        }

        return count;
    }
}
