import java.io.*;
import java.util.*;

public class Main {

    static int lowerBound(long[] arr, long target) {
        int left = 0;
        int right = arr.length;

        while (left < right) {
            int mid = left + (right - left) / 2;

            if (arr[mid] >= target) {
                right = mid;
            } else {
                left = mid + 1;
            }
        }

        return left;
    }

    static int upperBound(long[] arr, long target) {
        int left = 0;
        int right = arr.length;

        while (left < right) {
            int mid = left + (right - left) / 2;

            if (arr[mid] > target) {
                right = mid;
            } else {
                left = mid + 1;
            }
        }

        return left;
    }

    public static void main(String[] args) throws Exception {

        BufferedReader br =
                new BufferedReader(new InputStreamReader(System.in));

        int N = Integer.parseInt(br.readLine());

        long[] X = new long[N];
        long[] prefix = new long[N + 1];

        StringTokenizer st =
                new StringTokenizer(br.readLine());

        for (int i = 0; i < N; i++) {
            X[i] = Long.parseLong(st.nextToken());
        }

        st = new StringTokenizer(br.readLine());

        for (int i = 0; i < N; i++) {
            long population = Long.parseLong(st.nextToken());
            prefix[i + 1] = prefix[i] + population;
        }

        int Q = Integer.parseInt(br.readLine());

        StringBuilder ans = new StringBuilder();

        while (Q-- > 0) {

            st = new StringTokenizer(br.readLine());

            long L = Long.parseLong(st.nextToken());
            long R = Long.parseLong(st.nextToken());

            int leftIndex = lowerBound(X, L);
            int rightIndex = upperBound(X, R);

            long sum = prefix[rightIndex] - prefix[leftIndex];

            ans.append(sum).append('\n');
        }

        System.out.print(ans);
    }
}
