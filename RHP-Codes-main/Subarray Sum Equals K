import java.util.*;

class Solution {

    public int subarraySum(int[] nums, int k) {

        Map<Integer, Integer> freq = new HashMap<>();

        // Empty prefix
        freq.put(0, 1);

        int prefixSum = 0;
        int count = 0;

        for (int num : nums) {

            prefixSum += num;

            // Need an earlier prefix:
            // prefixSum - oldPrefix = k
            int required = prefixSum - k;

            count += freq.getOrDefault(required, 0);

            // Store current prefix sum
            freq.put(
                prefixSum,
                freq.getOrDefault(prefixSum, 0) + 1
            );
        }

        return count;
    }
}
