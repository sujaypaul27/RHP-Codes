import java.io.*;
import java.util.*;

public class Main {

    static int[][] st;
    static int[] log;

    static int query(int l, int r) {
        int len = r - l + 1;
        int k = log[len];

        return Math.min(
            st[k][l],
            st[k][r - (1 << k) + 1]
        );
    }

    public static void main(String[] args) throws Exception {

        BufferedReader br =
            new BufferedReader(new InputStreamReader(System.in));

        StringTokenizer stInput =
            new StringTokenizer(br.readLine());

        int n = Integer.parseInt(stInput.nextToken());
        int q = Integer.parseInt(stInput.nextToken());

        int[] a = new int[n];

        stInput = new StringTokenizer(br.readLine());

        for (int i = 0; i < n; i++) {
            a[i] = Integer.parseInt(stInput.nextToken());
        }

        // log[i] = floor(log2(i))
        log = new int[n + 1];

        for (int i = 2; i <= n; i++) {
            log[i] = log[i / 2] + 1;
        }

        // Number of levels
        int levels = log[n] + 1;

        st = new int[levels][n];

        // Level 0 = original array
        System.arraycopy(a, 0, st[0], 0, n);

        // Build Sparse Table
        for (int k = 1; k < levels; k++) {

            int length = 1 << k;
            int half = length >> 1;

            for (int i = 0; i + length <= n; i++) {

                st[k][i] = Math.min(
                    st[k - 1][i],
                    st[k - 1][i + half]
                );
            }
        }

        StringBuilder ans = new StringBuilder();

        while (q-- > 0) {

            stInput = new StringTokenizer(br.readLine());

            int l = Integer.parseInt(stInput.nextToken()) - 1;
            int r = Integer.parseInt(stInput.nextToken()) - 1;

            ans.append(query(l, r)).append('\n');
        }

        System.out.print(ans);
    }
}
